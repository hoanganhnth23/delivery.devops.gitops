project_id         = "lithe-paratext-506208-s5"
region             = "asia-southeast1"
cluster_name       = "delivery-cluster"
network_name       = "delivery-vpc"
subnet_name        = "delivery-gke-subnet"
artifact_repo_id   = "delivery-repo"

# Giữ node = 0 khi chưa dùng để tiết kiệm chi phí
initial_node_count = 0
node_count_min     = 0
node_count_max     = 8

# Sử dụng Spot VM để tiết kiệm ~60-70% chi phí compute
spot_instances     = false
machine_type       = "e2-standard-2"
disk_size_gb       = 50
disk_type          = "pd-balanced"
