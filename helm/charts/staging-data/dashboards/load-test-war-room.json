{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "ROW 1: INGRESS & TRAFFIC (RED METRICS)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Throughput by Service (RPS)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (application)",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "Error Rate (% 4xx & 5xx)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"[45]..\"}[1m])) or vector(0)) / (sum(rate(http_server_requests_seconds_count[1m])) or vector(1)) * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Latency p95 by URI (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, uri)) * 1000",
          "legendFormat": "p95 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 101,
      "title": "ROW 2: JVM & SERVICE RUNTIME",
      "type": "row"
    },
    {
      "id": 4,
      "title": "JVM Heap Memory Used",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "title": "GC Pause Time Average (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "expr": "(rate(jvm_gc_pause_seconds_sum[1m]) / rate(jvm_gc_pause_seconds_count[1m])) * 1000",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "title": "Active Live Threads",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 102,
      "title": "ROW 3: DATABASE & CACHE BOTTLENECK",
      "type": "row"
    },
    {
      "id": 7,
      "title": "HikariCP: Active vs Pending Connections",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active - {{application}}"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "PENDING (WAITING) - {{application}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Postgres Backends (CNPG)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "targets": [
        {
          "expr": "sum(cnpg_backends_total) by (datname, state)",
          "legendFormat": "{{datname}} {{state}}"
        },
        {
          "expr": "sum(cnpg_backends_waiting_total)",
          "legendFormat": "waiting on lock"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 9,
      "title": "Redis Ops/sec & Memory",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "targets": [
        {
          "expr": "rate(redis_commands_total[1m])",
          "legendFormat": "Ops/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 103,
      "title": "ROW 4: ASYNCHRONOUS PIPELINE (KAFKA)",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Kafka Consumer Lag by Group",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag) by (consumergroup, topic)",
          "legendFormat": "{{consumergroup}} - {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 11,
      "title": "Kafka Failures / DLT Events",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "expr": "sum(rate(delivery_business_events_total{outcome=~\"retry|dlt|failure\"}[1m])) by (event)",
          "legendFormat": "{{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 105,
      "title": "ROW 5: K8S RESOURCES & LOAD GENERATOR",
      "type": "row"
    },
    {
      "id": 20,
      "title": "Container CPU usage / limit (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"delivery-staging\",container!=\"\",container!=\"POD\"}[1m])) by (pod) / sum(kube_pod_container_resource_limits{namespace=\"delivery-staging\",resource=\"cpu\"}) by (pod) * 100",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 21,
      "title": "Container memory working set / limit (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"delivery-staging\",container!=\"\",container!=\"POD\"}) by (pod) / sum(kube_pod_container_resource_limits{namespace=\"delivery-staging\",resource=\"memory\"}) by (pod) * 100",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 22,
      "title": "CPU throttling (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 33
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"delivery-staging\"}[1m])) by (pod) / sum(rate(container_cpu_cfs_periods_total{namespace=\"delivery-staging\"}[1m])) by (pod) * 100",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 23,
      "title": "k6: request rate & VUs",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total[1m]))",
          "legendFormat": "k6 req/s"
        },
        {
          "expr": "sum(k6_vus)",
          "legendFormat": "VUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 24,
      "title": "k6: p95 latency & failed rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "max(k6_http_req_duration_p95) * 1000",
          "legendFormat": "p95 ms"
        },
        {
          "expr": "avg(k6_http_req_failed_rate) * 100",
          "legendFormat": "failed %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 25,
      "title": "Pod restarts",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"delivery-staging\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
